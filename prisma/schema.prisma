generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model approval_group_members {
  cd_id           Int             @id @default(autoincrement()) @db.UnsignedInt
  cd_group_id     Int             @db.UnsignedInt
  cd_user_id      Int             @db.UnsignedInt
  fl_active       Boolean         @default(true)
  approval_groups approval_groups @relation(fields: [cd_group_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_group_members_group")
  users           users           @relation(fields: [cd_user_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_group_members_user")

  @@unique([cd_group_id, cd_user_id], map: "uk_group_member")
  @@index([cd_user_id], map: "FK_group_members_user")
}

model approval_groups {
  cd_id                  Int                      @id @default(autoincrement()) @db.UnsignedInt
  ds_name                String                   @unique(map: "uk_approval_groups_name") @db.VarChar(150)
  ds_description         String?                  @db.Text
  fl_active              Boolean                  @default(true)
  dt_created_at          DateTime                 @default(now()) @db.DateTime(0)
  dt_updated_at          DateTime                 @default(now()) @db.DateTime(0)
  approval_group_members approval_group_members[]
  document_flow_steps    document_flow_steps[]
}

model backup_execution_events {
  cd_id               Int               @id @default(autoincrement()) @db.UnsignedInt
  cd_backup_execution Int               @db.UnsignedInt
  tp_event            String            @db.VarChar(50)
  st_status           BigInt            @default(1)
  ds_message          String?           @db.VarChar(500)
  dt_created_at       DateTime          @default(now()) @db.DateTime(0)
  backup_executions   backup_executions @relation(fields: [cd_backup_execution], references: [cd_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_backup_execution_events_execution")

  @@index([cd_backup_execution], map: "idx_execution")
  @@index([cd_backup_execution, dt_created_at], map: "idx_execution_created")
}

model backup_executions {
  cd_id                   Int                          @id @default(autoincrement()) @db.UnsignedInt
  cd_backup_job           Int                          @db.UnsignedInt
  ds_execution_type       String                       @db.VarChar(20)
  cd_nas_task             Int?
  ds_external_id          String?                      @db.VarChar(100)
  st_status               backup_executions_st_status? @default(RUNNING)
  dt_started_at           DateTime                     @db.DateTime(0)
  dt_finished_at          DateTime?                    @db.DateTime(0)
  nr_duration_seconds     Int?
  vl_size                 BigInt?
  ds_file_path            String?                      @db.VarChar(500)
  ds_error                String?                      @db.Text
  dt_created_at           DateTime?                    @default(now()) @db.DateTime(0)
  dt_updated_at           DateTime?                    @default(now()) @db.DateTime(0)
  backup_execution_events backup_execution_events[]
  backup_jobs             backup_jobs                  @relation(fields: [cd_backup_job], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_backup_execution_job")

  @@index([cd_backup_job], map: "fk_backup_execution_job")
}

model backup_jobs {
  cd_id                  Int                 @id @default(autoincrement()) @db.UnsignedInt
  cd_backup_automation   Int
  ds_system              String              @db.VarChar(255)
  ds_description         String              @db.VarChar(255)
  ds_path                String              @db.VarChar(255)
  nr_retention_days      Int
  nr_backups_days        Int
  st_enabled             Int                 @default(1) @db.TinyInt
  dt_next_executation_at DateTime?           @db.DateTime(0)
  dt_created_at          DateTime            @default(now()) @db.DateTime(0)
  dt_updated_at          DateTime            @default(now()) @db.DateTime(0)
  backup_executions      backup_executions[]
}

model campaign_user_access {
  cd_campaign_user_access Int       @id @default(autoincrement()) @db.UnsignedInt
  cd_campaign             Int       @db.UnsignedInt
  cd_user                 Int       @db.UnsignedInt
  dt_first_seen           DateTime? @db.DateTime(0)
  dt_dismissed            DateTime? @db.DateTime(0)
  dt_accessed             DateTime? @db.DateTime(0)
  dt_completed            DateTime? @db.DateTime(0)
  dt_created              DateTime  @default(now()) @db.DateTime(0)
  campaigns               campaigns @relation(fields: [cd_campaign], references: [cd_campaign], onDelete: NoAction, onUpdate: NoAction, map: "FK_campaign_user_access_campaigns")
  users                   users     @relation(fields: [cd_user], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_campaign_user_access_users")

  @@index([cd_campaign], map: "FK_campaign_user_access_campaigns")
  @@index([cd_user], map: "idx_campaign_user")
  @@index([cd_user, dt_accessed], map: "idx_campaign_user_pending")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model campaigns {
  cd_campaign          Int                    @id @default(autoincrement()) @db.UnsignedInt
  cd_code              String                 @unique(map: "cd_code") @db.VarChar(50)
  ds_title             String                 @db.VarChar(255)
  ds_month_year        String                 @unique(map: "uk_campaign_month_year") @default("") @db.VarChar(50)
  ds_description       String?                @db.Text
  st_status            String                 @default("DRAFT") @db.VarChar(20)
  dt_publication       DateTime?              @unique(map: "uk_campaign_publication_date") @db.DateTime(0)
  dt_created           DateTime               @default(now()) @db.Timestamp(0)
  dt_updated           DateTime               @default(now()) @db.Timestamp(0)
  cd_owner             Int                    @default(0) @db.UnsignedInt
  ds_publication_url   String?                @db.Text
  st_active            Boolean                @default(true)
  campaign_user_access campaign_user_access[]
  users                users                  @relation(fields: [cd_owner], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_campaigns_users")

  @@index([cd_owner], map: "FK_campaigns_users")
  @@index([dt_publication], map: "idx_campaign_publication")
  @@index([st_status], map: "idx_campaign_status")
}

model document_flow_steps {
  cd_id                    Int                        @id @default(autoincrement()) @db.UnsignedInt
  cd_document_id           Int                        @db.UnsignedInt
  cd_group_id              Int                        @db.UnsignedInt
  nr_order                 Int                        @db.UnsignedInt
  documents                documents                  @relation(fields: [cd_document_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_flow_step_document")
  approval_groups          approval_groups            @relation(fields: [cd_group_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_flow_step_group")
  revision_flow_executions revision_flow_executions[]
  revision_step_approvals  revision_step_approvals[]

  @@unique([cd_document_id, cd_group_id], map: "uk_flow_step_group")
  @@unique([cd_document_id, nr_order], map: "uk_flow_step_order")
  @@index([cd_group_id], map: "FK_flow_step_group")
}

model document_revisions {
  cd_id                                               Int                          @id @default(autoincrement()) @db.UnsignedInt
  cd_document_id                                      Int                          @db.UnsignedInt
  cd_open_user_id                                     Int                          @db.UnsignedInt
  cd_approved_user_id                                 Int?                         @db.UnsignedInt
  fl_auto_opened                                      Boolean                      @default(false)
  ds_reason                                           String                       @db.VarChar(255)
  ds_description                                      String?                      @db.Text
  ds_status                                           document_revisions_ds_status @default(ABERTA)
  dt_due_date                                         DateTime?                    @db.DateTime(0)
  dt_completed_at                                     DateTime?                    @db.DateTime(0)
  dt_approved_at                                      DateTime?                    @db.DateTime(0)
  dt_created_at                                       DateTime                     @default(now()) @db.DateTime(0)
  dt_updated_at                                       DateTime                     @default(now()) @db.DateTime(0)
  users_document_revisions_cd_approved_user_idTousers users?                       @relation("document_revisions_cd_approved_user_idTousers", fields: [cd_approved_user_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_revisions_approved_user")
  documents                                           documents                    @relation(fields: [cd_document_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_revisions_document")
  users_document_revisions_cd_open_user_idTousers     users                        @relation("document_revisions_cd_open_user_idTousers", fields: [cd_open_user_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_revisions_open_user")
  document_versions                                   document_versions[]
  revision_flow_executions                            revision_flow_executions?
  revision_step_approvals                             revision_step_approvals[]

  @@index([cd_approved_user_id], map: "FK_revisions_approved_user")
  @@index([cd_open_user_id], map: "FK_revisions_open_user")
  @@index([cd_document_id], map: "idx_revisions_document")
  @@index([ds_status], map: "idx_revisions_status")
}

model document_settings {
  cd_id                           Int      @id @default(autoincrement()) @db.UnsignedInt
  nr_default_review_period_months Int      @default(12) @db.UnsignedInt
  nr_alert_days_1                 Int?     @db.UnsignedInt
  nr_alert_days_2                 Int?     @db.UnsignedInt
  nr_alert_days_3                 Int?     @db.UnsignedInt
  fl_auto_expire                  Boolean  @default(true)
  fl_auto_open_revision           Boolean  @default(true)
  dt_created_at                   DateTime @default(now()) @db.DateTime(0)
  dt_updated_at                   DateTime @default(now()) @db.DateTime(0)
}

model document_versions {
  cd_id              Int                         @id @default(autoincrement()) @db.UnsignedInt
  cd_document_id     Int                         @db.UnsignedInt
  cd_revision_id     Int                         @db.UnsignedInt
  nr_major           Int                         @default(0) @db.UnsignedInt
  nr_minor           Int                         @default(1) @db.UnsignedInt
  ds_version         String                      @db.VarChar(20)
  ds_view_url        String?                     @db.LongText
  ds_edit_url        String?                     @db.LongText
  ds_change_log      String?                     @db.Text
  ds_status          document_versions_ds_status @default(RASCUNHO)
  cd_create_user_id  Int                         @db.UnsignedInt
  dt_created_at      DateTime                    @default(now()) @db.DateTime(0)
  dt_approved_at     DateTime?                   @db.DateTime(0)
  users              users                       @relation(fields: [cd_create_user_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_versions_create_user")
  documents          documents                   @relation(fields: [cd_document_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_versions_document")
  document_revisions document_revisions          @relation(fields: [cd_revision_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_versions_revision")

  @@unique([cd_document_id, ds_version], map: "uk_versions_doc_version")
  @@index([cd_create_user_id], map: "FK_versions_create_user")
  @@index([cd_document_id], map: "idx_versions_document")
  @@index([cd_document_id, nr_major, nr_minor], map: "idx_versions_order")
  @@index([cd_revision_id], map: "idx_versions_revision")
}

model documents {
  cd_id                                    Int                   @id @default(autoincrement()) @db.UnsignedInt
  ds_code                                  String                @unique(map: "uk_documents_code") @db.VarChar(50)
  ds_title                                 String                @db.VarChar(200)
  ds_category                              String                @db.VarChar(200)
  ds_classification                        String?               @db.VarChar(100)
  ds_process                               String?               @db.VarChar(100)
  ds_status                                documents_ds_status   @default(RASCUNHO)
  cd_create_user_id                        Int                   @db.UnsignedInt
  cd_owner_user_id                         Int?                  @db.UnsignedInt
  cd_current_version_id                    Int?                  @db.UnsignedInt
  nr_review_period_months                  Int?                  @db.UnsignedInt
  dt_next_review                           DateTime?             @db.DateTime(0)
  dt_last_approved_at                      DateTime?             @db.DateTime(0)
  fl_flow_locked                           Boolean               @default(false)
  dt_created_at                            DateTime              @default(now()) @db.DateTime(0)
  dt_updated_at                            DateTime              @default(now()) @db.DateTime(0)
  document_flow_steps                      document_flow_steps[]
  document_revisions                       document_revisions[]
  document_versions                        document_versions[]
  users_documents_cd_create_user_idTousers users                 @relation("documents_cd_create_user_idTousers", fields: [cd_create_user_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_documents_create_user")
  users_documents_cd_owner_user_idTousers  users?                @relation("documents_cd_owner_user_idTousers", fields: [cd_owner_user_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_documents_owner_user")
  documents_events                         documents_events[]
  documents_roles                          documents_roles[]

  @@index([cd_create_user_id], map: "FK_documents_create_user")
  @@index([cd_current_version_id], map: "FK_documents_current_version")
  @@index([cd_owner_user_id], map: "FK_documents_owner_user")
  @@index([dt_next_review], map: "idx_documents_next_review")
  @@index([ds_status], map: "idx_documents_status")
}

model documents_events {
  cd_id          Int       @id @default(autoincrement()) @db.UnsignedInt
  cd_document_id Int       @db.UnsignedInt
  cd_user_id     Int?      @db.UnsignedInt
  cd_revision_id Int?      @db.UnsignedInt
  cd_version_id  Int?      @db.UnsignedInt
  cd_step_id     Int?      @db.UnsignedInt
  ds_event_type  String    @db.VarChar(100)
  ds_details     String?   @db.Text
  ds_ip          String?   @db.VarChar(100)
  ds_user_agent  String?   @db.Text
  dt_created_at  DateTime  @default(now()) @db.DateTime(0)
  documents      documents @relation(fields: [cd_document_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_events_document")
  users          users?    @relation(fields: [cd_user_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_events_user")

  @@index([cd_user_id], map: "FK_events_user")
  @@index([dt_created_at], map: "idx_events_created")
  @@index([cd_document_id], map: "idx_events_document")
  @@index([ds_event_type], map: "idx_events_type")
}

model documents_roles {
  cd_id          Int       @id @default(autoincrement()) @db.UnsignedInt
  cd_document_id Int       @db.UnsignedInt
  cd_role_id     Int       @db.UnsignedInt
  documents      documents @relation(fields: [cd_document_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_documents_roles_document")
  roles          roles     @relation(fields: [cd_role_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_documents_roles_role")

  @@unique([cd_document_id, cd_role_id], map: "uk_documents_roles")
  @@index([cd_role_id], map: "FK_documents_roles_role")
}

model documents_roles_old {
  cd_id          Int   @id @default(autoincrement()) @db.UnsignedInt
  cd_document_id Int   @db.UnsignedInt
  cd_role_id     Int   @db.UnsignedInt
  roles          roles @relation(fields: [cd_role_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_documents_roles_roles")

  @@index([cd_document_id], map: "FK_documents_roles_documents")
  @@index([cd_role_id], map: "FK_documents_roles_roles")
}

model masking_executions {
  cd_id                  Int                          @id @default(autoincrement())
  ds_execution_id        String                       @default("") @db.VarChar(200)
  ds_path                String                       @db.VarChar(200)
  ds_environment         String                       @default("HOMOLOGACAO") @db.VarChar(200)
  st_status              masking_executions_st_status
  cd_databases_expected  Int
  cd_databases_processed Int
  cd_databases_success   Int
  cd_databases_error     Int
  cd_records_processed   Int                          @default(0)
  dt_started_at          DateTime                     @db.DateTime(0)
  dt_finished_at         DateTime                     @db.DateTime(0)
}

model notifications {
  cd_id         Int       @id @default(autoincrement()) @db.UnsignedInt
  cd_user_id    Int?      @db.UnsignedInt
  ds_source     String    @db.VarChar(50)
  ds_event_type String    @db.VarChar(100)
  ds_title      String    @db.VarChar(255)
  ds_message    String    @db.Text
  dt_read_at    DateTime? @db.DateTime(0)
  dt_created_at DateTime? @default(now()) @db.DateTime(0)
  users         users?    @relation(fields: [cd_user_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_notifications_users")

  @@index([cd_user_id, dt_read_at], map: "idx_user_read")
}

model permissions {
  cd_id            Int                @id @default(autoincrement()) @db.UnsignedInt
  ds_key           String             @unique(map: "ds_key") @db.VarChar(100)
  ds_description   String?            @db.VarChar(255)
  role_permissions role_permissions[]
}

model privileges {
  cd_id            Int      @id @default(autoincrement()) @db.UnsignedInt
  ds_user          String   @db.VarChar(100)
  ds_server        String   @db.VarChar(100)
  privilege        String   @db.VarChar(100)
  ds_justification String   @db.VarChar(255)
  status           String   @db.VarChar(50)
  dt_start_at      DateTime @db.DateTime(0)
  dt_expires_at    DateTime @db.DateTime(0)
  dt_created_at    DateTime @default(dbgenerated("(curdate())")) @db.DateTime(0)
  dt_updated_at    DateTime @db.DateTime(0)
}

model revision_flow_executions {
  cd_id               Int                                @id @default(autoincrement()) @db.UnsignedInt
  cd_revision_id      Int                                @unique(map: "uk_execution_revision") @db.UnsignedInt
  cd_current_step_id  Int?                               @db.UnsignedInt
  nr_current_order    Int                                @default(1) @db.UnsignedInt
  ds_status           revision_flow_executions_ds_status @default(EM_ANDAMENTO)
  dt_started_at       DateTime                           @default(now()) @db.DateTime(0)
  dt_finished_at      DateTime?                          @db.DateTime(0)
  document_flow_steps document_flow_steps?               @relation(fields: [cd_current_step_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_execution_current_step")
  document_revisions  document_revisions                 @relation(fields: [cd_revision_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_execution_revision")

  @@index([cd_current_step_id], map: "FK_execution_current_step")
}

model revision_step_approvals {
  cd_id               Int                               @id @default(autoincrement()) @db.UnsignedInt
  cd_revision_id      Int                               @db.UnsignedInt
  cd_step_id          Int                               @db.UnsignedInt
  cd_user_id          Int                               @db.UnsignedInt
  ds_action           revision_step_approvals_ds_action
  ds_comments         String?                           @db.Text
  dt_action_at        DateTime                          @default(now()) @db.DateTime(0)
  document_revisions  document_revisions                @relation(fields: [cd_revision_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_step_approval_revision")
  document_flow_steps document_flow_steps               @relation(fields: [cd_step_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_step_approval_step")
  users               users                             @relation(fields: [cd_user_id], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_step_approval_user")

  @@unique([cd_revision_id, cd_step_id, cd_user_id], map: "uk_step_approval")
  @@index([cd_step_id], map: "FK_step_approval_step")
  @@index([cd_user_id], map: "FK_step_approval_user")
}

model role_permissions {
  cd_role       Int         @db.UnsignedInt
  cd_permission Int         @db.UnsignedInt
  roles         roles       @relation(fields: [cd_role], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "role_permissions_ibfk_1")
  permissions   permissions @relation(fields: [cd_permission], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "role_permissions_ibfk_2")

  @@id([cd_role, cd_permission])
  @@index([cd_permission], map: "cd_permission")
}

model roles {
  cd_id               Int                   @id @default(autoincrement()) @db.UnsignedInt
  ds_name             String                @db.VarChar(100)
  ds_description      String?               @db.VarChar(255)
  st_status           Int                   @default(0) @db.TinyInt
  dt_created_at       DateTime              @default(now()) @db.DateTime(0)
  documents_roles     documents_roles[]
  documents_roles_old documents_roles_old[]
  role_permissions    role_permissions[]
  user_roles          user_roles[]
}

model user_roles {
  cd_user Int   @db.UnsignedInt
  cd_role Int   @db.UnsignedInt
  users   users @relation(fields: [cd_user], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "user_roles_ibfk_1")
  roles   roles @relation(fields: [cd_role], references: [cd_id], onDelete: NoAction, onUpdate: NoAction, map: "user_roles_ibfk_2")

  @@id([cd_user, cd_role])
  @@index([cd_role], map: "cd_role")
}

model users {
  cd_id                                                            Int                       @id @default(autoincrement()) @db.UnsignedInt
  ds_name                                                          String                    @db.VarChar(255)
  ds_email                                                         String                    @unique(map: "Index 2") @db.VarChar(255)
  cd_id_glpi                                                       String                    @db.VarChar(255)
  cd_id_microsoft                                                  String                    @db.VarChar(255)
  ds_role_description                                              String                    @db.VarChar(255)
  ds_vpn_name                                                      String                    @db.VarChar(255)
  ds_avatar_url                                                    String?                   @db.VarChar(100)
  ds_password                                                      String                    @db.VarChar(255)
  fl_active                                                        Int                       @default(0) @db.TinyInt
  dt_last_login                                                    DateTime?                 @db.DateTime(0)
  dt_last_password_change                                          DateTime?                 @db.DateTime(0)
  ds_latitude                                                      String                    @db.VarChar(100)
  ds_longitude                                                     String                    @db.VarChar(100)
  dt_created_at                                                    DateTime                  @default(dbgenerated("(curdate())")) @db.DateTime(0)
  dt_updated_at                                                    DateTime                  @default(now()) @db.DateTime(0)
  approval_group_members                                           approval_group_members[]
  campaign_user_access                                             campaign_user_access[]
  campaigns                                                        campaigns[]
  document_revisions_document_revisions_cd_approved_user_idTousers document_revisions[]      @relation("document_revisions_cd_approved_user_idTousers")
  document_revisions_document_revisions_cd_open_user_idTousers     document_revisions[]      @relation("document_revisions_cd_open_user_idTousers")
  document_versions                                                document_versions[]
  documents_documents_cd_create_user_idTousers                     documents[]               @relation("documents_cd_create_user_idTousers")
  documents_documents_cd_owner_user_idTousers                      documents[]               @relation("documents_cd_owner_user_idTousers")
  documents_events                                                 documents_events[]
  notifications                                                    notifications[]
  revision_step_approvals                                          revision_step_approvals[]
  user_roles                                                       user_roles[]
}

enum masking_executions_st_status {
  SUCCESS
  PARTIAL_ERROR
  ERROR
}

enum revision_flow_executions_ds_status {
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
  AGUARDA_AJUSTE
}

enum revision_step_approvals_ds_action {
  APROVAR
  SOLICITAR_AJUSTE
  CANCELAR
}

enum backup_executions_st_status {
  RUNNING
  SUCCESS
  FAILED
}

enum documents_ds_status {
  RASCUNHO
  EM_REVISAO
  EM_APROVACAO
  VIGENTE
  EXPIRADO
  CANCELADO
}

enum document_revisions_ds_status {
  ABERTA
  EM_APROVACAO
  APROVADA
  CANCELADA
}

enum document_versions_ds_status {
  RASCUNHO
  EM_APROVACAO
  APROVADA
  CANCELADA
}
